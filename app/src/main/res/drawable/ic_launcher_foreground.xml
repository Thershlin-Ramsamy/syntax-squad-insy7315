<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground: geometric hard-hat mark.

  Three primitives only — a white semicircular dome, a navy crown groove cut
  through it as negative space, and an orange pill brim. A hard hat is the most
  immediately legible symbol of the trade and, unlike a crane or a building
  outline, it still reads at 48px.

  The groove is subtractive rather than an added shape: an added ridge sitting on
  the dome reads as an exclamation mark, while a groove running down into the
  brim reads as the crown of a helmet.

  The brim is the widest element at 66dp (x 21..87), which keeps the whole mark
  inside the 72dp safe zone launcher masks never crop. Vertically the mark is
  centred on 54 by construction: dome top 37.83, brim bottom 70.17.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Dome -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M32.88,58.95 A21.12,21.12 0 0 1 75.12,58.95 Z" />

    <!-- Crown groove — matches the background navy so it reads as cut out -->
    <path
        android:fillColor="#0B3D91"
        android:pathData="M49.71,48.03 A4.29,4.29 0 0 1 58.29,48.03 L58.29,70.17 L49.71,70.17 Z" />

    <!-- Brim, drawn last so it closes the dome and groove cleanly -->
    <path
        android:fillColor="#F9A826"
        android:pathData="M26.61,58.95 H81.39 A5.61,5.61 0 0 1 81.39,70.17 H26.61 A5.61,5.61 0 0 1 26.61,58.95 Z" />
</vector>
