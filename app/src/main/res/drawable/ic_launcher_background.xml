<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon background: flat brand navy.

  Deliberately a single solid fill. The launcher masks this layer to whatever
  shape the device uses, and any gradient or motif placed here gets cropped
  unpredictably across those masks — a solid brand colour is the only treatment
  that reads identically on every device.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#0B3D91"
        android:pathData="M0,0h108v108h-108z" />
</vector>
